{
  "name": "sakura-system-autocenter",
  "version": "0.9.51",
  "private": true,
  "type": "module",
  "description": "Sakura System — AutoCenter Edition",
  "author": "Sakura Corp",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc -b && vite build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contraste": "node scripts/varredura-contraste.mjs",
    "gerar-instalacao": "node scripts/gerar-instalacao-completa.mjs",
    "typecheck": "tsc -b",
    "test:fusos": "node scripts/testar-nos-dois-fusos.mjs",
    "contraste:telas": "node scripts/varredura-contraste-dom.mjs",
    "largura:telas": "node scripts/varredura-largura-telas.mjs",
    "test:rls": "node supabase/testes-rls/rodar.mjs",
    "test:atualizar-bancos": "node scripts/atualizar-bancos.integracao.mjs",
    "test:sql": "node scripts/testar-sql.mjs",
    "test:electron": "xvfb-run -a node scripts/testar-electron.mjs",
    "checar-versao-electron": "node scripts/checar-versao-electron.mjs",
    "comparar:electron": "xvfb-run -a -s \"-screen 0 1920x1080x24\" node scripts/comparar-telas-electron.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@supabase/supabase-js": "^2.110.8",
    "electron-updater": "^6.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.sakuracorp.autocenter",
    "productName": "Sakura System - AutoCenter Edition",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "SakuraSystem-Setup.exe",
    "publish": {
      "provider": "github",
      "owner": "sakura-corp",
      "repo": "ssace-versoes",
      "releaseType": "release"
    },
    "afterPack": "scripts/ligar-fuses.mjs",
    "asar": true
  }
}
