// Publicação do painel na Cloudflare (tarefa #352; docs/painel.md, "Andamento", 01/10).
// Quem publica é a Cloudflare, a partir da `main` ("Workers Builds"); não há script de publicar aqui.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Tem que ser o mesmo nome do Worker criado na Cloudflare.
  "name": "sakura-painel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Mantém o endereço sakura-painel.caranovavidanova.workers.dev ligado e a prévia desligada
  // a cada publicação.
  "workers_dev": true,
  "preview_urls": false,
  // Login (#353). O Client ID do app "Sakura Painel" não é segredo. O client secret e a
  // CHAVE_DA_SESSAO são segredos: só na Cloudflare (e no .dev.vars de quem programa).
  // Financeiro (#654): o login do GitHub de quem vê cada lançamento e lança. Não é segredo.
  // Vazia: ninguém é dona (o worker falha fechado).
  "vars": {
    "GITHUB_APP_CLIENT_ID": "Iv23liveky5fWf6C7oO2",
    "DONA_DO_FINANCEIRO": "caranovavidanova"
  },
  // Tempo real (#355): a sala que repassa os avisos do GitHub a todos os painéis abertos.
  // `new_sqlite_classes` = Durable Object com SQLite, que está no plano grátis.
  // O segredo GITHUB_WEBHOOK_SECRET fica só na Cloudflare (e no .dev.vars de quem programa).
  "durable_objects": {
    "bindings": [{ "name": "SALA", "class_name": "SalaDoPainel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SalaDoPainel"] }],
  "assets": {
    "directory": "./dist",
    // Deixa o worker entregar a página (env.ASSETS) quando precisar.
    "binding": "ASSETS",
    // Caminho que não é arquivo (/sala, /sala?tv, /escritorio) recebe o index.html.
    "not_found_handling": "single-page-application",
    // Só /api/* passa pelo worker; o resto é servido direto dos arquivos da página.
    "run_worker_first": ["/api/*"]
  }
}
